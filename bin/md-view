#!/usr/bin/env bash
# md-view: render a markdown note and read it in the terminal (kitty graphics).
#
# Default engine is typst, which compiles the same note about 30x faster than
# the TeX path (0.3s vs 9.5s on a 2700-word note) with equally good maths. The
# page is sized to the aspect ratio of this terminal rather than to paper, so
# one page is one screenful in doc-view and `j` reads like scrolling.
#
# env
#   MDVIEW_ENGINE    typst (default) | tectonic
#   MDVIEW_FONTSIZE  apparent text size, 10|11|12|14|17|20 (default 14pt).
#                    Under typst this sets the measure: bigger text, fewer
#                    characters per line. Passed through as-is to tectonic.
#   MDVIEW_FONT      sans (default, Cantarell) | droid | helvetica | serif,
#                    or any family name typst can see (`typst fonts`)
#   MDVIEW_MATHFONT  serif by default; "sans" for TeX Gyre DejaVu Math
#   MDVIEW_THEME     light (default) | dark
#   MDVIEW_COLUMNS   1 (default) | 2. Two columns fit far more on a wide
#                    window, but a long line of code cannot wrap and will
#                    overflow a narrow column.
#   MDVIEW_JUSTIFY   1 (default) | 0. Notes dense with inline code justify
#                    badly, because a code span cannot hyphenate; 0 gives
#                    ragged right and even word spacing.
#   MDVIEW_ASPECT    override the width:height ratio of the page, e.g. 1.6
#   MDVIEW_KEEP      keep the generated PDF and print its path
set -euo pipefail

if [[ $# -lt 1 ]]; then
    cat >&2 <<'MSG'
usage: md-view FILE.md [pandoc-args...]
env:   MDVIEW_ENGINE=typst|tectonic  MDVIEW_FONTSIZE=14pt
       MDVIEW_THEME=light|dark  MDVIEW_COLUMNS=1|2  MDVIEW_ASPECT=1.6
MSG
    exit 1
fi

in="$1"; shift
[[ -f "$in" ]] || { echo "md-view: no such file: $in" >&2; exit 1; }

out="$(mktemp -t mdview-XXXXXX.pdf)"
typ=""
cleanup() {
    rm -f "$typ" "$typ.err"
    [[ -z "${MDVIEW_KEEP:-}" ]] && rm -f "$out"
    return 0
}
trap cleanup EXIT

fontsize="${MDVIEW_FONTSIZE:-14pt}"
engine="${MDVIEW_ENGINE:-typst}"

# Notes are not papers: "@270 epochs" is an epoch count, not a citation key,
# and pandoc's citation extension turns it into one, which then fails to
# compile for want of a bibliography.
from="${MDVIEW_FROM:-markdown-citations}"

render_tectonic() {
    pandoc "$in" \
        -f "$from" \
        --pdf-engine=tectonic \
        -V documentclass=extarticle \
        -V fontsize="$fontsize" \
        -V geometry:margin=0.6in \
        "$@" \
        -o "$out"
}

if [[ "$engine" == tectonic ]]; then
    render_tectonic "$@"
    [[ -n "${MDVIEW_KEEP:-}" ]] && echo "$out" >&2
    exec doc-view "$out"
fi

# ---------------------------------------------------------------- geometry ---
# The page has to match the box doc-view will actually draw into, or the image
# is letterboxed and a band of terminal background shows above and below it.
# That box is not the whole window: doc-view keeps the bottom row for its status
# line, and shaves a column under tmux to stop a Unicode placeholder in the last
# column from triggering autowrap.
#
# TIOCGWINSZ carries the window's size in pixels as well as in cells, which
# gives the true cell shape. Guessing it (a cell is "about twice as tall as it
# is wide") is what put a band of background under every page: real terminal
# cells run nearer 1:2.2, so the guessed page came out too wide.
# The 2>/dev/null wraps the whole compound, so bash's own complaint about a
# missing /dev/tty is swallowed too, not just perl's.
geom=$( { perl -e 'ioctl(STDIN, 0x5413, $w) or exit 1;
                   print join(" ", unpack("S4", $w)), "\n";' </dev/tty; } 2>/dev/null ) || geom=""
read -r rows cols xpix ypix <<<"$geom"
[[ -n "${cols:-}" && "$cols" -gt 0 ]] || { cols=$(tput cols 2>/dev/null || echo 100); }
[[ -n "${rows:-}" && "$rows" -gt 0 ]] || { rows=$(tput lines 2>/dev/null || echo 30); }

box_cols=$cols
[[ -n "${TMUX:-}" ]] && box_cols=$((cols - 1))
box_rows=$((rows - 1))
(( box_cols > 0 )) || box_cols=1
(( box_rows > 0 )) || box_rows=1

aspect="${MDVIEW_ASPECT:-}"
if [[ -z "$aspect" ]]; then
    aspect=$(awk -v bc="$box_cols" -v br="$box_rows" -v c="$cols" -v r="$rows" \
                 -v xp="${xpix:-0}" -v yp="${ypix:-0}" 'BEGIN{
        if (xp > 0 && yp > 0) { cw = xp/c; ch = yp/r; }
        else                  { cw = 1;    ch = 2.15; }   # fallback cell shape
        a = (bc*cw)/(br*ch);
        if (a < 0.4) a = 0.4; if (a > 4.0) a = 4.0;
        printf "%.4f", a
    }')
fi
[[ -n "${MDVIEW_DEBUG:-}" ]] && \
    echo "md-view: ${cols}x${rows} cells, ${xpix:-?}x${ypix:-?} px, box ${box_cols}x${box_rows}, aspect $aspect" >&2

# The page is 1000pt wide by definition; only ratios reach the screen, since
# doc-view rescales whatever it is given. Everything else follows from that.
page_w=1000
page_h=$(awk -v a="$aspect" 'BEGIN{printf "%d", 1000/a}')
margin_x=44
margin_y=$(awk -v h="$page_h" 'BEGIN{m=h*0.045; if(m<20)m=20; printf "%d", m}')
columns="${MDVIEW_COLUMNS:-1}"
justify=true
[[ "${MDVIEW_JUSTIFY:-1}" == 0 ]] && justify=false

# Body face. Each entry carries its own width constant: the point size that
# delivers a given number of characters per line depends on the face, so the
# measure knob would mean something different for each one otherwise. The
# constant is the mean glyph width as a fraction of the point size, measured
# from rendered output.
case "${MDVIEW_FONT:-sans}" in
    sans|cantarell) mainfont='"Cantarell", "Droid Sans", "Nimbus Sans"'; glyph_w=0.48 ;;
    droid)          mainfont='"Droid Sans", "Nimbus Sans"';              glyph_w=0.50 ;;
    helvetica|nimbus) mainfont='"Nimbus Sans", "Droid Sans"';            glyph_w=0.49 ;;
    serif|libertinus) mainfont='"Libertinus Serif", "Nimbus Roman"';     glyph_w=0.43 ;;
    *)              mainfont="\"${MDVIEW_FONT}\""; glyph_w="${MDVIEW_GLYPH_WIDTH:-0.48}" ;;
esac

# Apparent size: MDVIEW_FONTSIZE is a familiar knob from the TeX path, so keep
# it, and convert it to a measure. 14pt -> 115 characters per line, 17 -> 95,
# 20 -> 80; larger text simply means fewer characters across.
size_num="${fontsize%pt}"
measure=$(awk -v s="$size_num" 'BEGIN{m=1610/s; if(m<50)m=50; if(m>200)m=200; printf "%d", m}')
text_w=$(awk -v w="$page_w" -v m="$margin_x" -v c="$columns" \
    'BEGIN{t=w-2*m; if(c>1) t=(t-18*(c-1))/c; printf "%.2f", t}')
# Calibrated against rendered output: an average glyph in Libertinus at these
# sizes measures 0.43 of its point size, so the size that actually delivers
# `measure` characters across the text block is width / (0.43 * measure).
# Measured back with pdftotext, a request for 115 lands within a character or
# two of 115.
font_pt=$(awk -v t="$text_w" -v m="$measure" -v g="$glyph_w" 'BEGIN{printf "%.2f", t/(g*m)}')

# ------------------------------------------------------------------ colours --
case "${MDVIEW_THEME:-light}" in
    dark)
        bg=1b1d1e; fg=e6e3dd; fg2=b9b5ac; accent=8fb8d8
        codebg=26292b; border=3a3e40; link=8fb8d8; rule=4a4e50 ;;
    *)
        bg=fdfcf9; fg=1b1b1b; fg2=4a4a4a; accent=2c5f8a
        codebg=f1efe8; border=ddd9cf; link=2c5f8a; rule=c9c4b8 ;;
esac

# Maths keeps a serif face by default. A sans body with serif equations is
# normal typesetting practice, and the alternative here is worse: the only sans
# maths font on this machine, TeX Gyre DejaVu Math, draws a squat integral sign.
# Setting a text font without a MATH table is not an option at all — big
# operators collapse to inline size. MDVIEW_MATHFONT switches it anyway.
case "${MDVIEW_MATHFONT:-}" in
    "")        mathfont='"New Computer Modern Math"' ;;
    sans|dejavu) mathfont='"TeX Gyre DejaVu Math"' ;;
    *)         mathfont="\"${MDVIEW_MATHFONT}\"" ;;
esac

# TinyTeX ships the TeX Gyre maths families; let typst see them.
TEXGYRE="$HOME/.TinyTeX/texmf-dist/fonts/opentype/public/tex-gyre-math"
font_path_arg=()
[[ -d "$TEXGYRE" ]] && font_path_arg=(--font-path "$TEXGYRE")

TEMPLATE="${MDVIEW_TEMPLATE:-$HOME/.config/mdview/mdview.typ}"
[[ -f "$TEMPLATE" ]] || { echo "md-view: template missing: $TEMPLATE" >&2; exit 1; }

typ="$(mktemp -t mdview-XXXXXX.typ)"

pandoc "$in" \
    -f "$from" \
    -t typst \
    --standalone \
    --template="$TEMPLATE" \
    -V pagewidth="$page_w" \
    -V pageheight="$page_h" \
    -V marginx="$margin_x" \
    -V marginy="$margin_y" \
    -V columns="$columns" \
    -V justify="$justify" \
    -V fontsize="$font_pt" \
    -V mainfont="$mainfont" \
    -V mathfont="$mathfont" \
    -V bg="$bg" -V fg="$fg" -V fg2="$fg2" -V accent="$accent" \
    -V codebg="$codebg" -V border="$border" -V link="$link" -V rule="$rule" \
    "$@" \
    -o "$typ"

# Three repairs to what pandoc's typst writer emits, all seen on real notes:
#
#   ∥x∥_F^2   bare norm bars, so the script attaches to the closing bar
#             instead of to the whole norm. lr() restores the grouping and
#             makes the bars stretch.
#   sqrt()    from a literal \sqrt{} in the source; typst rejects an empty
#             radicand.
#   ^l med    a one-character script followed by a spacing macro is emitted
#             with no separator, so typst reads the identifier "lmed".
#
# The norm bar is written \x{2225} rather than literally: -CSD decodes the
# file being edited but not the literals in the program text, so a pasted ∥
# would be compared as raw bytes against a decoded character and never match.
perl -CSD -i -pe '
    s/\x{2225}([^\x{2225}\n]*)\x{2225}/lr(\x{2225}$1\x{2225})/g;
    s/\bsqrt\(\)/sqrt(" ")/g;
    s/([_^])([A-Za-z0-9])(med|thin|thick|quad)\b/$1$2 $3/g;
' "$typ"

# Relative image paths in the generated source would resolve against the
# temporary file's directory, not the note's, so a note that embeds a figure
# compiles to "file not found". Rewrite them to absolute paths; --root /
# below is what makes those loadable.
srcdir=$(cd "$(dirname "$in")" && pwd)
perl -CSD -i -pe '
    BEGIN { $d = shift @ARGV }
    s{(image\(\s*")([^"/][^"]*)(")}{$1 . $d . "/" . $2 . $3}ge;
' "$srcdir" "$typ"

# A viewer should never simply refuse to show a note. If typst trips over
# something in the generated source, say so and fall back to the slow path
# rather than leaving the reader with nothing.
if ! typst compile "${font_path_arg[@]}" --root / "$typ" "$out" 2>"$typ.err"; then
    sed 's/^/typst: /' "$typ.err" >&2
    rm -f "$typ.err"
    echo "md-view: typst failed on this note; falling back to tectonic" >&2
    render_tectonic "$@"
else
    rm -f "$typ.err"
fi

[[ -n "${MDVIEW_KEEP:-}" ]] && echo "$out" >&2
exec doc-view "$out"
