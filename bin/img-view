#!/usr/bin/env bash
# img-view: clear screen + display image filling terminal box (fits W and H).
set -euo pipefail

cols=$(tput cols)
rows=$(tput lines)
h=$((rows - 1))

# Under tmux, passthrough mode uses Unicode placeholders. Writing a placeholder
# to the final column triggers terminal autowrap, dragging trailing cells onto
# the next row and corrupting the rightmost column of the image. Shave one
# column to keep the placeholder grid strictly inside the pane.
w=$cols
if [[ -n "${TMUX:-}" ]]; then
  w=$((cols - 1))
fi

KITTEN="${KITTEN:-$HOME/.local/share/kitty-ssh-kitten/kitty/bin/kitten}"

# Clear any prior kitty graphics + text scrollback view.
"$KITTEN" icat --clear --silent --transfer-mode=memory </dev/null 2>/dev/null || true
clear

"$KITTEN" icat \
  --place="${w}x${h}@0x0" \
  --scale-up \
  --align=center \
  -- "$@"

# Wait for any key; works under tmux unlike kitten's --hold.
read -n 1 -s -r </dev/tty
"$KITTEN" icat --clear --silent --transfer-mode=memory </dev/null 2>/dev/null || true
