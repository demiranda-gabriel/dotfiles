#!/usr/bin/env bash
# tmux-window-fzf — a Ctrl-b w replacement with a side-by-side layout:
#   window list on the LEFT (with a Claude-session state glyph), live pane
#   preview on the RIGHT. Launched from a tmux display-popup (see `bind-key w`).
#
# State glyph mirrors the tab bar, driven by the per-window @claude_state option
# set by the claude-tmux-state hook:
#   ● orange = running   ○ orange = waiting (bg/ext, not your turn)   ● green = your turn
set -eo pipefail

# Be robust to the popup's PATH: fzf lives in ~/.local/bin, fall back to PATH.
FZF="$HOME/.local/bin/fzf"; [ -x "$FZF" ] || FZF="fzf"

sel=$(
  tmux list-windows -a \
    -F $'#{session_name}:#{window_index}\t#{@claude_state}\t#{?window_active,1,0}\t#{session_name}: #{window_name}  (#{window_panes}p)' \
  | awk -F'\t' 'BEGIN{e=sprintf("%c",27); r=e"[0m"}
      {
        s=$2
        if      (s=="running") g=e"[38;5;208m●"r
        else if (s=="bg")      g=e"[38;5;208m○"r
        else if (s=="ext")     g=e"[38;5;208m○"r
        else if (s=="you")     g=e"[38;5;46m●"r
        else                   g=e"[38;5;240m·"r
        act=($3=="1") ? e"[1m›"r" " : "  "
        printf "%s\t%s %s%s\n", $1, g, act, $4
      }' \
  | "$FZF" --ansi --delimiter=$'\t' --with-nth=2 \
        --preview='tmux capture-pane -pet {1} | tail -n "${FZF_PREVIEW_LINES:-40}"' \
        --preview-window='right:65%' \
        --reverse --prompt='search ❯ ' \
        --header='jk:move  g/G:ends  s:search  ⏎:switch  esc:cancel' \
        --no-input \
        --bind 'j:down,k:up,g:first,G:last' \
        --bind 'ctrl-d:half-page-down,ctrl-u:half-page-up' \
        --bind 's:unbind(j,k,g,G,s)+show-input'
)

[ -n "${sel:-}" ] && tmux switch-client -t "${sel%%$'\t'*}"
