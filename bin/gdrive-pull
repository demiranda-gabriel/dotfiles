#!/usr/bin/env bash
# gdrive-pull <remote_subpath> [<local_dest>] [-p PROJECT] [-n]
#
# Copy from mir-backup:Current_members/Gabriel/projects/<PROJECT>/<remote_subpath> into <local_dest>
# (default: current directory). If <remote_subpath> ends in a filename,
# only that file is fetched; otherwise the whole subtree.
#
# PROJECT resolution (first hit wins):
#   1. -p flag
#   2. $PROJECT_NAME env var
#   3. basename of `git rev-parse --show-toplevel`
#
# Flags:
#   -p PROJECT   override project name
#   -n           dry-run
#   -h           help

set -euo pipefail

usage() { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' >&2; exit "${1:-0}"; }

DRY=0
PROJECT=""
POSITIONAL=()

while (( $# )); do
    case "$1" in
        -p) PROJECT="$2"; shift 2 ;;
        -n) DRY=1; shift ;;
        -h|--help) usage 0 ;;
        --) shift; POSITIONAL+=("$@"); break ;;
        -*) echo "unknown flag: $1" >&2; usage 1 ;;
        *) POSITIONAL+=("$1"); shift ;;
    esac
done

(( ${#POSITIONAL[@]} >= 1 )) || { echo "missing <remote_subpath>" >&2; usage 1; }

SUBPATH="${POSITIONAL[0]}"
DEST="${POSITIONAL[1]:-.}"

if [[ -z "$PROJECT" ]]; then
    PROJECT="${PROJECT_NAME:-}"
fi
if [[ -z "$PROJECT" ]]; then
    if root=$(git rev-parse --show-toplevel 2>/dev/null); then
        PROJECT=$(basename "$root")
    fi
fi
[[ -n "$PROJECT" ]] || { echo "could not resolve PROJECT (use -p or set PROJECT_NAME or run inside a git repo)" >&2; exit 1; }

SUBPATH="${SUBPATH#/}"
SUBPATH="${SUBPATH%/}"
# Remote base: MIR-backup shared (Team) drive, under Current_members/Gabriel.
# Override via $GDRIVE_REMOTE_BASE if the destination ever moves.
REMOTE_BASE="${GDRIVE_REMOTE_BASE:-mir-backup:Current_members/Gabriel/projects}"
REMOTE="${REMOTE_BASE}/${PROJECT}/${SUBPATH}"

mkdir -p "$DEST"
CMD=(rclone copy -P "$REMOTE" "$DEST")

echo "→ ${CMD[*]}"
(( DRY )) && exit 0
"${CMD[@]}"
