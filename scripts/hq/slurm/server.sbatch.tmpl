#!/bin/bash
#SBATCH -J hq-server
#SBATCH -p __SRV_PART__
#SBATCH -c __SRV_CPUS__
#SBATCH --mem=__SRV_MEM__
#SBATCH -t __SRV_WALL__
#SBATCH -o __HQDIR__/server.%j.log
# No scheduler mail: match the PBS side (#PBS -m n) — the fleet's Slack webhook
# already reports every state transition.
#SBATCH --mail-type=NONE

# HyperQueue server, hosted ON A COMPUTE NODE, with SELF-CHAINING auto-restart.
#
# Why a compute node: FASRC firewalls login<->compute on arbitrary ports both
# ways, so the server can't live on a login node (workers can't dial back; the
# login client can't reach it). Workers reach it compute<->compute; the `hq`
# client ssh-bridges to the node recorded in ~/.hq/server-node.
#
# Why self-chaining: FASRC's only instant, non-preempting CPU partition
# (sapphire) caps at 3 days — equal to the GPU worker max — and FASRC forbids
# raising walltime in place. The longer partitions are jammed (kozinsky/
# intermediate) or preempt others (unrestricted). So instead each server queues
# a DEPENDENT successor (afterany) that starts the instant this one ends; the
# journal (~/.hq/journal) hands off all state and workers reconnect via their
# retry loop (gap = a few seconds). Net: an effectively immortal server on the
# free, instant partition. `hq-fleet down --all` drops the ~/.hq/server-stop
# sentinel then scancels the chain; a successor released by that scancel sees
# the sentinel and exits. Set HQ_NO_CHAIN=1 for a single, non-chaining server.
export PATH=$HOME/.local/bin:$PATH
HQDIR="$HOME/.hq"
STOP="$HQDIR/server-stop"
SELF="$HQDIR/server.sbatch"

# Teardown sentinel: a successor released by `down --all`'s scancel exits here.
if [[ -e "$STOP" ]]; then
    echo "[hq-server] stop sentinel present ($STOP) — not starting; chain ends."
    exit 0
fi

echo "[hq-server] node=$(hostname -s) ip=$(hostname -i) job=${SLURM_JOB_ID:-?} start=$(date -u +%FT%TZ)"
echo "$(hostname -s)" > "$HQDIR/server-node"
trap 'rm -f "$HQDIR/server-node"' EXIT

# Queue the successor BEFORE serving, so the chain survives even an abrupt end.
if [[ "${HQ_NO_CHAIN:-0}" != 1 && -n "${SLURM_JOB_ID:-}" && -f "$SELF" ]]; then
    if succ=$(sbatch --parsable --dependency=afterany:"$SLURM_JOB_ID" "$SELF" 2>/dev/null); then
        echo "[hq-server] queued successor $succ (starts afterany:$SLURM_JOB_ID)"
    else
        echo "[hq-server] WARN: could not queue successor (chain will not self-renew)"
    fi
fi

exec hq server start --journal "$HQDIR/journal"
