# Per-host fleet config. Copy to ~/.hq/fleet.env and fill in. NEVER commit the
# real file — NTFY_TOPIC is effectively a password (anyone who knows it can
# read/send your notifications), and SLACK_WEBHOOK is a secret URL.
#
# All three are optional; leave a line blank/removed to disable that channel.

# Slack incoming-webhook URL for fleet state-transition pushes.
SLACK_WEBHOOK=

# ntfy.sh topic (pick a long unguessable string). Subscribe in the ntfy app.
NTFY_TOPIC=

# Label shown in notifications ("hq-fleet @ <label>"). Defaults to Polaris.
HQ_FLEET_LABEL=Polaris

# Extra args appended to every `hq worker start` (sourced by the fleet PBS
# scripts). Tokens are word-split, so no spaces *within* a single value. Empty
# = none. HQ auto-detects only NVIDIA/AMD GPUs, so other accelerators must be
# registered here. Aurora (Intel PVC), pair with ~/.hq/hq-xpu-bind.sh:
#   HQ_WORKER_RESOURCES="--resource gpus/intel=range(0-5)"
HQ_WORKER_RESOURCES=
