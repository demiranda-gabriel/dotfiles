# ---- views ------------------------------------------------------------------
def user_cell(t):
    """User column for a task/waiting dict. A "~" marks an owner inferred from
    the submit directory rather than read off the "<user>:" name prefix."""
    user = t["user"]
    mark = DIM("~") if t.get("guess") else ""
    if user == "?":
        return DIM("?")
    return (GREEN(user) if user == os.environ.get("USER", "") else user) + mark

def gpu_view(nodes, waiting, allocs=None, mock=False):
    rows, total, busy = [], 0, 0
    cpu_only = []          # running tasks that hold no GPU at all
    for nd in nodes:
        total += nd["ngpus"]
        slot = 0
        for t in sorted(nd["tasks"], key=lambda t: -(t["runtime_s"] or 0)):
            ngpus = t.get("ngpus") or 0
            if ngpus < 1:
                # CPU-only task (`hq submit --cpus N` with no gpus/nvidia
                # request). It occupies cores, NOT a GPU. The old expression
                # `range(max(n,1) if n else 1)` sent a 0-GPU task down the
                # slot loop anyway, so it consumed a GPU row and incremented
                # `busy` — over-reporting occupancy and hiding genuinely free
                # GPUs (a lone CPU task on an idle node read as "1/4 in use").
                # Track it separately and list it under the table instead.
                cpu_only.append((nd["host"], t))
                continue
            for i in range(ngpus):
                if slot >= nd["ngpus"]:
                    break                       # over-assignment guard
                label = f"{t['job']} " + BLUE(t["name"])
                if ngpus > 1 and i > 0:
                    label = DIM(f"└ same task (gpu {i+1}/{ngpus})")
                rows.append([nd["host"], str(slot), YELLOW("running"),
                             label, user_cell(t),
                             fmt_age(t["runtime_s"]),
                             DIM(nd.get("alloc", "—"))])
                slot += 1
                busy += 1
        for g in range(slot, nd["ngpus"]):
            rows.append([nd["host"], str(g), BOLD(GREEN("free")),
                         DIM("—"), DIM("—"), DIM("—"), DIM(nd.get("alloc", "—"))])

    hdr = f"{busy}/{total} GPUs in use · {len(nodes)} node(s) attached"
    if waiting:
        hdr += f" · {sum(w['ntasks'] for w in waiting)} task(s) waiting"
    if cpu_only:
        hdr += f" · {len(cpu_only)} cpu-only task(s)"
    if mock:
        hdr = RED("[MOCK DATA] ") + hdr
    print(BOLD(hdr))
    # One line per PBS allocation feeding this server. Anything outside the
    # standing fleet (a one-off `medium` job, an autoalloc debug node) is named
    # here by its own job id and queue rather than hiding inside the totals.
    for a in allocs or []:
        left = (fmt_age(a["left_s"]) + " left") if a.get("left_s") is not None \
            else "no time limit"
        if a.get("left_s") is not None and a["left_s"] < 3600:
            left = RED(left)
        print(f"  alloc {BOLD(a['alloc'])} · {a.get('name', '?')} · "
              f"{a.get('queue', '?')} · {a['nodes']} node(s) · "
              f"{a['ngpus']} GPUs · {left}")
    if rows:
        print(render(["Node", "GPU", "Status", "Job", "User", "Runtime", "Alloc"],
                     rows, aligns=["l", "r", "l", "l", "l", "r", "l"]))
    else:
        print(DIM("no workers attached — fleet paused or between weekly "
                  "allocations (qstat -u demiranda to check)"))
    if cpu_only:
        # Listed rather than dropped: these are running work, they just hold no
        # GPU. Showing them keeps the view honest without inflating occupancy.
        crows = [[str(t["job"]), BLUE(t["name"]), user_cell(t), host,
                  fmt_age(t["runtime_s"])] for host, t in cpu_only]
        print(BOLD("\ncpu-only (holds no GPU):"))
        print(render(["Job", "Name", "User", "Node", "Runtime"], crows,
                     aligns=["r", "l", "l", "l", "r"]))
    if waiting:
        wrows = [[str(w["job"]), BLUE(w["name"]), user_cell(w),
                  str(w["ntasks"]),
                  (f"{w['gpus_per_task']} GPU" if w["gpus_per_task"] else "CPU"),
                  fmt_age(w["age_s"])] for w in waiting]
        print(BOLD("\nwaiting:"))
        # "Submitted", not "Queued for": age_s is measured from job SUBMISSION,
        # and HQ drops the task start time when a task is requeued (worker lost
        # / preemption), so time-actually-spent-waiting is not recoverable. The
        # old label claimed the latter and could report "5.1 d" for a task that
        # had trained for days and been waiting only 14 minutes.
        print(render(["Job", "Name", "User", "Tasks", "Per-task", "Submitted"],
                     wrows, aligns=["r", "l", "l", "r", "l", "r"]))
    # Legend only when it applies: "~" owners are a good inference, not a fact
    # the scheduler recorded, and the distinction matters on a shared fleet.
    if any(t.get("guess") for nd in nodes for t in nd["tasks"]) \
            or any(w.get("guess") for w in waiting):
        print(DIM('\n~ owner inferred from the job\'s submit directory '
                  '(its name carries no "<user>:" prefix)'))

def main():
    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print(__doc__ or open(__file__).read().split('"""')[0])
        sys.exit(
            "usage: hq-gpus [--mock]\n"
            "  (no args)  live per-GPU view of the shared fleet\n"
            "  --mock     synthetic demo data (no server needed)")
    if "--mock" in args:
        gpu_view(*collect_mock(), mock=True)
        return
    gpu_view(*collect_live())

if __name__ == "__main__":
    main()
