#!/usr/bin/env python3
# hq-gpus — GPU status of the HetRxnEnergy shared HyperQueue fleet.
#
# One row per GPU across every attached worker node: free or running, which
# job holds it, who submitted it, and for how long. Every worker the server
# knows is listed, whatever PBS job spawned it — the standing fleet, an
# autoalloc debug node, or a one-off allocation such as a 25-node `medium`
# job. An "allocations" block under the header names each PBS job feeding
# the server (queue, node/GPU count, time left) and the Alloc column ties
# every GPU row back to it. Ownership comes from the
# "<user>:" job-name convention; a job submitted without that prefix is
# attributed from its submit directory instead (marked "~" in the User
# column) rather than shown as an anonymous "?".
#
# Waiting jobs are listed below the table, followed by any running CPU-only
# tasks — those hold cores rather than GPUs, so they are counted separately
# and never occupy a GPU row.
#
# Works for EVERY project member: it needs only the shared client access
# file (no ssh to the operator's compute nodes, no nvidia-smi) — everything
# is derived from the HQ scheduler's own state. Consequently the GPU column
# is a *logical slot* (0..3 filled in task order), not the physical index
# nvidia-smi would report; occupancy, ownership, and runtimes are exact.
#
# Usage: hq-gpus            live fleet view
#        hq-gpus --mock     synthetic data through the same rendering path
#                           (interface development / demo; no server needed)
import datetime
import json
import os
import pwd
import re
import subprocess
import sys

SHARE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
os.environ.setdefault("HQ_SERVER_DIR", os.path.join(SHARE, "client"))
HQ = os.path.join(SHARE, "bin", "hq")
if not os.path.exists(HQ):
    HQ = "hq"

PIPE = dict(stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True)

def hq_json(*args):
    try:
        r = subprocess.run([HQ, "--output-mode=json", *args], timeout=30, **PIPE)
        return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None
    except Exception:
        return None

# ---- colour helpers (same conventions as lhj) ------------------------------
TTY = sys.stdout.isatty() or os.environ.get("HQ_GPUS_COLOR") == "1"  # hq-gpus-all renders into a temp file
def c(code, s):
    return f"\033[{code}m{s}\033[0m" if TTY else s
BOLD  = lambda s: c("1", s)
DIM   = lambda s: c("2", s)
RED   = lambda s: c("31", s)
GREEN = lambda s: c("32", s)
YELLOW= lambda s: c("33", s)
BLUE  = lambda s: c("38;5;39", s)
_ANSI = re.compile(r"\033\[[0-9;]*m")
def vlen(s):
    return len(_ANSI.sub("", s))

def render(headers, rows, aligns=None):
    ncol = len(headers)
    aligns = aligns or ["l"] * ncol
    widths = [max(vlen(headers[i]), *(vlen(r[i]) for r in rows)) if rows
              else vlen(headers[i]) for i in range(ncol)]
    def cell(txt, i):
        pad = widths[i] - vlen(txt)
        return (" " + txt + " " * pad + " ") if aligns[i] == "l" else \
               (" " + " " * pad + txt + " ")
    def line(l, m, r):
        return l + m.join("─" * (widths[i] + 2) for i in range(ncol)) + r
    out = [line("┌", "┬", "┐"),
           "│" + "│".join(cell(BOLD(headers[i]), i) for i in range(ncol)) + "│",
           line("├", "┼", "┤")]
    for row in rows:
        out.append("│" + "│".join(cell(row[i], i) for i in range(ncol)) + "│")
    out.append(line("└", "┴", "┘"))
    return "\n".join(out)

def fmt_age(secs):
    if secs is None or secs < 0:
        return "--"
    if secs < 3600:
        return f"{round(secs / 60)} min"
    if secs < 2 * 86400:
        return f"{secs / 3600:.1f} h"
    return f"{secs / 86400:.1f} d"

def split_name(name):
    """'wcw:zno-md' -> ('wcw', 'zno-md'); no prefix -> ('?', name)."""
    m = re.match(r"^([A-Za-z0-9_.-]+):(.+)$", name or "")
    return (m.group(1), m.group(2)) if m else ("?", name or "?")

# --- fallback attribution: submit directory ---------------------------------
# The "<user>:" name prefix is a convention, not something HQ enforces: a submit
# that sets --name explicitly (or runs from a shell that bypasses the client
# wrappers) lands in the queue unprefixed and used to render as "?". Every job
# does carry its submit-time cwd, and on this machine a working directory is
# under /home/<user>/ or /lus/<fs>/projects/<proj>/<user>/, so the owner is
# recoverable. Only names that resolve to a real account are accepted, which
# keeps shared subdirs (".../HetRxnEnergy/shared/...") from inventing a user.
_CWD_USER = re.compile(r"^/(?:home|lus/[^/]+/projects/[^/]+)/([A-Za-z0-9_.-]+)/")
_IS_USER = {}

def _is_account(name):
    if name not in _IS_USER:
        try:
            pwd.getpwnam(name)
            _IS_USER[name] = True
        except Exception:          # KeyError, or a flaky LDAP lookup
            _IS_USER[name] = False
    return _IS_USER[name]

def _job_cwd(info):
    """Submit-time working directory from `hq job info` json ('' if absent)."""
    found = []
    def walk(o):
        if isinstance(o, dict):
            v = o.get("cwd")
            if isinstance(v, str) and v:
                found.append(v)
            for x in o.values():
                walk(x)
        elif isinstance(o, list):
            for x in o:
                walk(x)
    walk(info)
    return found[0] if found else ""

def user_from_cwd(info):
    """Owner inferred from the job's submit directory, or None."""
    m = _CWD_USER.match(_job_cwd(info))
    return m.group(1) if m and _is_account(m.group(1)) else None

def ts(s):
    try:
        return datetime.datetime.strptime(s[:19], "%Y-%m-%dT%H:%M:%S").replace(
            tzinfo=datetime.timezone.utc) if s else None
    except Exception:
        return None

# ---- data model -------------------------------------------------------------
# nodes   = [{host, ngpus, alloc, tasks: [{job, name, user, guess, ngpus, runtime_s}]}]
#           (one entry per running task on that node; ngpus GPUs each;
#            alloc = short PBS job id of the allocation the node runs in)
# waiting = [{job, name, user, guess, ntasks, gpus_per_task, age_s}]
# allocs  = [{alloc, name, queue, nodes, ngpus, left_s}]  one per PBS allocation
# `guess` = user came from the submit directory, not the name prefix.

# hq stores resource request amounts as fixed-point ×10⁴
# (validated live 2026-07-29: 1 GPU -> {"request": {"Compact": 10000}}).
_SCALE = 10_000

def _amount(req):
    """{"Compact": 40000} / {"Scatter": ...} / raw int -> units."""
    if isinstance(req, (int, float)):
        return int(req // _SCALE) if req >= _SCALE else int(req)
    if isinstance(req, dict):
        for v in req.values():
            if isinstance(v, (int, float)):
                return int(v // _SCALE)
    return 0

def _job_gpus_per_task(info):
    """gpus/nvidia per task from `hq job info` json (0 = cpu-only)."""
    found = []
    def walk(o):
        if isinstance(o, dict):
            if o.get("resource") == "gpus/nvidia" and "request" in o:
                found.append(_amount(o["request"]))
            for v in o.values():
                walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)
    walk(info)
    return max(found) if found else 0

def _worker_ngpus(w):
    """GPU count from the worker resource descriptor (validated live:
    {"kind": "range", "start": 0, "end": 3} on Polaris); fallback 4."""
    res = (w.get("configuration", {}).get("resources", {}) or {})
    for r in res.get("resources", []):
        if r.get("name") == "gpus/nvidia":
            kind = r.get("kind")
            if kind == "range":
                return int(r["end"]) - int(r["start"]) + 1
            if kind == "list":
                return len(r.get("values", []))
            if kind == "groups":
                return sum(len(g) for g in r.get("groups", []))
            if kind == "sum":
                return int(r.get("size", 0))
    return 4  # Polaris fallback

# ---- allocations -------------------------------------------------------------
# HQ records the PBS job each worker was started under (`allocation.id`, set by
# the worker from $PBS_JOBID). Grouping workers by it makes ad-hoc allocations
# visible next to the standing fleet instead of blending into one pool: a
# 25-node `medium` job and the 4-node `capacity` job read as two lines here.
def _alloc_id(w):
    a = (w.get("allocation") or {}).get("id") or ""
    return a.split(".")[0] if a else "manual"

_PBS_FACTS = {}
def _pbs_job_facts(jid):
    """(queue, Job_Name) via `qstat -f`, best effort — ('?', '?') when the
    scheduler is unreachable or the worker was not started under PBS."""
    if jid in _PBS_FACTS:
        return _PBS_FACTS[jid]
    q = nm = "?"
    if jid != "manual":
        try:
            r = subprocess.run(["qstat", "-f", jid], timeout=15, **PIPE)
            if r.returncode == 0:
                m = re.search(r"^\s*queue = (\S+)", r.stdout, re.M)
                q = m.group(1) if m else q
                m = re.search(r"^\s*Job_Name = (\S+)", r.stdout, re.M)
                nm = m.group(1) if m else nm
        except Exception:
            pass
    _PBS_FACTS[jid] = (q, nm)
    return q, nm

def _prefetch_pbs(jids):
    """Fill _PBS_FACTS with one `qstat -f` for every allocation at once."""
    jids = [j for j in jids if j != "manual" and j not in _PBS_FACTS]
    if not jids:
        return
    try:
        r = subprocess.run(["qstat", "-f", *jids], timeout=15, **PIPE)
    except Exception:
        return
    for block in re.split(r"^Job Id: ", r.stdout, flags=re.M)[1:]:
        jid = block.split(".", 1)[0].strip()
        m = re.search(r"^\s*queue = (\S+)", block, re.M)
        n = re.search(r"^\s*Job_Name = (\S+)", block, re.M)
        _PBS_FACTS[jid] = (m.group(1) if m else "?", n.group(1) if n else "?")

def summarize_allocs(workers, now):
    by = {}
    for w in workers:
        aid = _alloc_id(w)
        e = by.setdefault(aid, {"alloc": aid, "nodes": 0, "ngpus": 0, "left_s": None})
        e["nodes"] += 1
        e["ngpus"] += _worker_ngpus(w)
        st = ts(w.get("started"))
        tl = w.get("configuration", {}).get("time_limit")
        if st and tl:
            left = int((st + datetime.timedelta(seconds=tl) - now).total_seconds())
            e["left_s"] = left if e["left_s"] is None else min(e["left_s"], left)
    _prefetch_pbs([e["alloc"] for e in by.values()])
    for e in by.values():
        e["queue"], e["name"] = _pbs_job_facts(e["alloc"])
    return sorted(by.values(), key=lambda e: (-e["nodes"], e["alloc"]))

def collect_live():
    now = datetime.datetime.now(datetime.timezone.utc)
    workers = hq_json("worker", "list")
    if workers is None:   # doubles as the reachability check (was a separate `server info`, +0.3 s)
        sys.exit("hq-gpus: cannot reach the HQ server on polaris-login-01 "
                 "(it self-heals within ~10 min; ping the operator if this persists)")
    active = {w["id"]: w for w in workers if w.get("ended") is None}
    nodes = {w["id"]: {"host": w.get("configuration", {}).get("hostname", "?"),
                       "ngpus": _worker_ngpus(w), "tasks": [],
                       "alloc": _alloc_id(w)}
             for w in active.values()}
    allocs = summarize_allocs(active.values(), now)

    waiting = []
    jobs = hq_json("job", "list") or []   # non-terminal jobs only
    # Two batched calls instead of two per job: every `hq` invocation costs
    # ~0.3 s of client start-up + server handshake, so per-job calls made this
    # O(jobs) and took ~25 s at 30 jobs. `job info` / `task list` accept a
    # comma-separated id selector and return a list / a dict keyed by job id.
    sel = ",".join(str(j["id"]) for j in jobs)
    infos = {d["info"]["id"]: [d] for d in (hq_json("job", "info", sel) or [])} if sel else {}
    tls = (hq_json("task", "list", sel) or {}) if sel else {}
    for j in jobs:
        jid = j["id"]
        user, name = split_name(j.get("name", ""))
        info = infos.get(jid)
        gpt = _job_gpus_per_task(info)    # gpus per task (0 = cpu-only)
        guess = False
        if user == "?":                   # no "<user>:" prefix — fall back to cwd
            owner = user_from_cwd(info)
            if owner:
                user, guess = owner, True
        tasks = tls.get(str(jid), []) if isinstance(tls, dict) else []
        n_wait = 0
        for t in tasks:
            st = (t.get("state") or "").lower()
            if st == "running" and t.get("worker") in nodes:
                start = ts(t.get("started_at"))
                rt = int((now - start).total_seconds()) if start else None
                nodes[t["worker"]]["tasks"].append(
                    {"job": jid, "name": name, "user": user, "guess": guess,
                     "ngpus": gpt, "runtime_s": rt})
            elif st == "waiting":
                n_wait += 1
        if n_wait:
            # job-level started_at (job info top level) = submission time
            sub = None
            if isinstance(info, list) and info:
                sub = ts(info[0].get("started_at"))
            age = int((now - sub).total_seconds()) if sub else None
            waiting.append({"job": jid, "name": name, "user": user,
                            "guess": guess, "ntasks": n_wait,
                            "gpus_per_task": gpt, "age_s": age})
    return (sorted(nodes.values(), key=lambda n: (n["alloc"], n["host"])),
            waiting, allocs)

