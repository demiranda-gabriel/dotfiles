#!/bin/bash
#PBS -A __ACCOUNT__
#PBS -q __BRIDGE_QUEUE__
#PBS -l select=1:system=__SYSTEM__
#PBS -l filesystems=__FILESYSTEMS__
#PBS -l place=scatter
#PBS -N bravo-1n
#PBS -j oe
#PBS -o __HQDIR__/bravo/workers.log
#
# BRAVO-FLEET worker: ONE node (4 A100s) on the `preemptable` queue, attached to
# the same HQ server as alpha-fleet, so both fleets feed one task pool.
#
# Why one node and not four: on 2026-08-15 a 4-node preemptable request was
# TERMINATED by the scheduler after 6 min without ever running
# ("Insufficient amount of resource: queue_tags and terminated"), while a
# 1-node request submitted 5 min later stayed queued healthily. Wide jobs must
# find a block of tagged nodes; narrow ones fit ordinary backfill. Many small
# allocations also decorrelate preemption — losing one costs one node, not the
# whole fleet.
#
# WALLTIME IS SET AT SUBMIT TIME (`qsub -l walltime=...`), deliberately
# staggered across the fleet so allocations do not all expire together and
# recreate the very gap this fleet exists to cover.
export PATH=$HOME/.local/bin:$PATH
# Group-shared fleet: tasks may be submitted by any project member but run as
# this job's owner. umask 002 keeps task outputs group-writable.
umask 002

# No core dumps from tasks (2026-08-27). Polaris's default `ulimit -c unlimited`
# + core_pattern=core means any SIGSEGV/SIGABRT in a task writes a core into the
# task's cwd — which is the SUBMIT dir, i.e. someone's repo root. A torch python
# crash cores at ~1.5 GB: 12 of them (16 GB) were found in the multifidelity root
# on 2026-08-25. The login-node guard in dotfiles/shell/41-polaris.sh is
# hostname-gated and so never covered compute nodes. Set it on the RANK, not just
# here on the mom node: PBS/PALS launches ranks from the per-node daemon, which
# does not inherit the mom shell's rlimits. Tasks inherit it from the worker.
ulimit -c 0

NNODES=$(wc -l < "$PBS_NODEFILE")
echo "$(date -u +%FT%TZ) bravo worker starting on $NNODES node(s): $(cat $PBS_NODEFILE | tr '\n' ' ')"

# HQ >=0.26 creates a unix socket under $TMPDIR; the PBS per-job TMPDIR is too
# long and blows the 108-char SUN_LEN limit (worker exits instantly; verified
# on Polaris 2026-08-16 — crash-looped the whole first bravo fleet). Short
# node-local dir instead; mkdir runs PER NODE inside the mpiexec.
#
# CRITICAL (2026-08-16): exporting TMPDIR here is NOT enough. PALS `mpiexec`
# does not propagate the override to the ranks — each rank gets the long
# per-job PBS TMPDIR back, so the worker still died with "path must be shorter
# than SUN_LEN" and the loop retried every 60 s forever, contributing ZERO GPUs
# while still billing the allocation. Resolve the path on the mom node and pass
# it into the rank command as a LITERAL; never rely on env propagation.
WORKER_TMPDIR=/local/scratch/$USER/tmp
# BOOTSTRAP (2026-08-20): create the short dir on EVERY node BEFORE exporting
# the short TMPDIR — PALS itself creates its per-app dir under $TMPDIR on each
# rank with a NON-recursive mkdir, so on nodes where the dir does not yet
# exist the launch dies before the rank command's own `mkdir -p` ever runs
# ("launch failed: Couldn't create directory ...: No such file or directory";
# stranded 9 bravo nodes x 23 h on 2026-08-20). This mpiexec runs with the
# default PBS TMPDIR, which always exists, so PALS can launch it anywhere.
mpiexec -n "$NNODES" --ppn 1 bash -c "mkdir -p '$WORKER_TMPDIR'"
# Kept for anything running on the mom node (safe now the dir exists).
export TMPDIR=$WORKER_TMPDIR

while true; do
    # --on-server-lost finish-running: a preemption or server blip must not
    # discard work already in flight on this node.
    # Quoting: "$WORKER_TMPDIR" expands HERE (mom node); \"\$TMPDIR\" stays
    # escaped so it is read on the rank AFTER the export.
    mpiexec -n "$NNODES" --ppn 1 --cpu-bind none \
        bash -c "export TMPDIR='$WORKER_TMPDIR'
                 mkdir -p \"\$TMPDIR\" || { echo \"FATAL: cannot mkdir \$TMPDIR on \$(hostname)\"; exit 1; }
                 ulimit -c 0
                 exec hq --server-dir $HOME/.hq-bravo-server worker start --on-server-lost finish-running"
    echo "$(date -u +%FT%TZ): workers exited; retrying in 60s (server restart or preemption?)"
    sleep 60
done
