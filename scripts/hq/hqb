#!/bin/bash
# hqb — hq client for the PRIVATE bravo server (demiranda-only preemptable
# fleet, up to 40 A100s). Usage identical to hq: hqb submit ..., hqb job list,
# hqb worker list. The shared server stays plain `hq` (alpha/capacity fleet).

# Submit hooks — task-log routing + "<user>:" job-name prefix (see
# hq-submit-hooks.sh). This script cannot inherit the `hq()` shell function — it
# execs the binary — so it applies them itself, or every `hqb submit` drops a
# job-<id>/ dir into the cwd and lands unowned in the fleet view. Resolved via
# the script's own real path so it works through the ~/.local/bin symlink.
_self="$(readlink -f "${BASH_SOURCE[0]}")"
_hooks="${_self%/*}/hq-submit-hooks.sh"
if [[ -r "$_hooks" ]]; then
    . "$_hooks"
    hq_submit_hooks_argv bravo "$@"
    set -- "${HQ_ARGV[@]}"
fi

exec "$HOME/.local/bin/hq" --server-dir "$HOME/.hq-bravo-server" "$@"
