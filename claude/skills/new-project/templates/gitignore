# --- Storage tiers (see DATA_MANAGEMENT.md) ---------------------------------
# Bulk data — gdrive-tracked. `/data/*` not `/data`, so subdirs can be
# re-included later (git cannot descend into an excluded directory).
/data/*
!/data/README.md
# Models — curated .nequip.zip packages, gdrive-tracked.
/models/*
!/models/README.md
# Literature PDFs — gdrive-tracked (111 MB at creation; too heavy for git).
/papers/*
!/papers/README.md
# Training outputs — local-only, regenerable from experiments/.
/runs
# Per-experiment convenience symlink <exp>/runs -> ../../runs/<N>-<exp>
# (recreate with scripts/link_experiment_runs.sh).
experiments/**/runs

