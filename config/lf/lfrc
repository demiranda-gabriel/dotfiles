# =====================================================================
# lf config — VS Code is the default opener; terminal viewers on `t` (md-view,
# termpdf, img-view), marp on M/W, kitty download on yK.
# NOTE: do NOT nest ${VAR:-${OTHER}} inside ${{ ... }} — the inner `}}`
# terminates the lf block early. Use single-level expansion only.
# =====================================================================

# --- core options ---
set hidden false
set ignorecase true
set icons false
set drawbox false
set ratios 1:2:3
set scrolloff 8
set period 1
set previewer ~/.config/lf/preview
set cleaner  ~/.config/lf/cleaner

# --- open dispatch (default action on Enter / `l`) ---
# VS Code is the default opener for EVERY file type. lf normally runs inside a
# VS Code integrated terminal, where `code` hands the path to the editor window
# over the socket named by $VSCODE_IPC_HOOK_CLI. Async (`&`) so lf never gives
# up the tty: `code` needs no terminal and returns as soon as the window has
# the file, leaving lf exactly where it was.
#
# Outside VS Code (plain ssh/tmux) there is no window to hand the file to, so
# we bounce back into lf via `-remote send` and run the terminal viewers
# instead. The `-S` test is what makes that robust: on ALCF login nodes the
# variable often survives while the socket underneath it does not (systemd
# reaps /run/user/$UID — see the XDG_RUNTIME_DIR block in
# bin/vscode-login-tunnel.sh), and an unreachable socket must degrade to the
# viewers rather than swallow the keypress. A non-zero exit from `code` falls
# back the same way.
#
# Directories are unaffected: lf's builtin `open` (mapped to <enter>/l) enters
# a directory and only reaches this command for regular files.
#
# `O` forces the terminal-viewer lane even inside VS Code — use it for pdf /
# epub / djvu, which VS Code cannot render without an extension. (Not `t`:
# that is lf's built-in tag-toggle.)
cmd open &{{
    if [ -n "$VSCODE_IPC_HOOK_CLI" ] && [ -S "$VSCODE_IPC_HOOK_CLI" ]; then
        # $fx is newline-separated (all of the selection, or the file under the
        # cursor when nothing is selected); NUL-delimit it so paths containing
        # spaces survive, and open the whole batch in one `code` call. Paths
        # from lf are absolute, so none can be mistaken for an option.
        if printf '%s\n' "$fx" | tr '\n' '\0' | xargs -0 -r code -r 2>/dev/null; then
            exit 0
        fi
    fi
    lf -remote "send $id open-terminal"
}}

# --- terminal viewers (the pre-VS-Code dispatch; `O`, and the fallback) ---
cmd open-terminal ${{
    case "$f" in
        *.md|*.markdown)
            md-view "$f"
            ;;
        *.pdf|*.epub|*.djvu|*.cbz|*.fb2|*.xps)
            termpdf "$f"
            ;;
        *.png|*.jpg|*.jpeg|*.gif|*.webp|*.tif|*.tiff|*.bmp)
            img-view "$f"
            ;;
        *)
            mime=$(file --mime-type -Lb "$f")
            ed=${VISUAL:-$EDITOR}
            [ -z "$ed" ] && ed=vi
            case "$mime" in
                text/*|application/json|application/xml|application/x-shellscript)
                    "$ed" "$f"
                    ;;
                *)
                    xdg-open "$f" 2>/dev/null || "$ed" "$f"
                    ;;
            esac
            ;;
    esac
}}
map O open-terminal

# --- markdown font-size variants ---
cmd md_big  ${{ MDVIEW_FONTSIZE=17pt md-view "$f" }}
cmd md_huge ${{ MDVIEW_FONTSIZE=20pt md-view "$f" }}
map B md_big
map H md_huge

# --- marp slides: build PDF, view in termpdf ---
# Detects a marp deck (frontmatter `marp: true`). If sibling package.json
# defines `slides:pdf`, uses that (preserves theme/flags); else falls back
# to a direct `marp` invocation, auto-passing any sibling `themes/*.css`
# as --theme so per-project themes apply without extra config. Output
# PDF reused in-place; --html accepts the deck's inline HTML blocks.
cmd marp_view ${{
    set -e
    case "$f" in *.md|*.markdown) : ;; *)
        printf "marp_view: not a markdown file\n" >&2; exit 1 ;;
    esac
    if ! head -n 30 "$f" | grep -q '^marp: true'; then
        printf "marp_view: '%s' has no 'marp: true' frontmatter\n" "$f" >&2
        exit 1
    fi
    dir=$(dirname "$f")
    base=$(basename "$f" .md)
    out="$dir/$base.pdf"
    cd "$dir"
    if [ -f package.json ] && grep -q '"slides:pdf"' package.json; then
        npm run --silent slides:pdf
    else
        set --
        for css in themes/*.css; do
            [ -e "$css" ] || continue
            set -- "$@" --theme "$css"
        done
        marp "$f" -o "$out" "$@" --pdf --html --allow-local-files --no-stdin
    fi
    termpdf "$out"
}}
map M marp_view

# --- marp slides: background watcher (rebuilds PDF on save) ---
# Toggle: first press starts `marp -w` detached, second press stops it.
# PID + log live in /tmp keyed by deck-path hash so deck dirs stay clean.
# Auto-passes any sibling `themes/*.css` as --theme so per-project themes
# apply without extra config. Pair with `M` (marp_view) which opens
# slides.pdf in termpdf; press Ctrl-R inside termpdf to reload after each
# rebuild.
cmd marp_watch &{{
    case "$f" in *.md|*.markdown) : ;; *)
        lf -remote "send $id echoerr 'marp_watch: not a markdown file'"
        exit 1 ;;
    esac
    if ! head -n 30 "$f" | grep -q '^marp: true'; then
        lf -remote "send $id echoerr 'marp_watch: no marp: true frontmatter'"
        exit 1
    fi
    dir=$(dirname "$f")
    base=$(basename "$f" .md)
    out="$dir/$base.pdf"
    key=$(printf '%s' "$f" | md5sum | cut -c1-12)
    pidfile="/tmp/marp-watch-$key.pid"
    logfile="/tmp/marp-watch-$key.log"
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
        kill "$(cat "$pidfile")" 2>/dev/null
        rm -f "$pidfile"
        lf -remote "send $id echo 'marp watcher stopped'"
        exit 0
    fi
    cd "$dir"
    set --
    for css in themes/*.css; do
        [ -e "$css" ] || continue
        set -- "$@" --theme "$css"
    done
    nohup marp -w "$f" -o "$out" "$@" --pdf --html --allow-local-files --no-stdin \
        >"$logfile" 2>&1 < /dev/null &
    pid=$!
    echo "$pid" > "$pidfile"
    lf -remote "send $id echo 'marp watcher started — pid $pid, log $logfile'"
}}
map W marp_watch

# --- pdf single-page peek (kitten icat fallback) ---
cmd pdf_peek ${{
    pdftoppm -jpeg -r 150 -singlefile -- "$f" - \
      | ~/.local/share/kitty-ssh-kitten/kitty/bin/kitten icat --hold --stdin=yes
}}
map P pdf_peek

# --- kitty transfer: download highlighted/selected files to local Mac ---
cmd kitty_download ${{
    KITTEN=$KITTEN
    [ -z "$KITTEN" ] && KITTEN=$HOME/.local/share/kitty-ssh-kitten/kitty/bin/kitten
    DEST="/Users/demiranda/Downloads/"
    for path in $fx; do
        "$KITTEN" transfer --direction=download "$path" "$DEST"
    done
}}
map yK kitty_download

# --- copy current file's full path to the Mac clipboard via OSC 52 ---
# kitty permits clipboard *writes* by default, so no Mac-side config needed.
# Inside tmux the OSC 52 is wrapped in a passthrough sequence so tmux forwards
# it raw to kitty; outside tmux it goes direct. The path is also echoed to the
# message line as a visible, mouse-selectable fallback.
cmd copy_path ${{
    b64=$(printf '%s' "$f" | base64 | tr -d '\n')
    if [ -n "$TMUX" ]; then
        printf '\033Ptmux;\033\033]52;c;%s\007\033\\' "$b64" > /dev/tty
    else
        printf '\033]52;c;%s\007' "$b64" > /dev/tty
    fi
    lf -remote "send $id echo copied to clipboard: $f"
}}
map Y copy_path

# --- open with custom command ---
cmd open-with ${{
    clear
    printf "open with: "
    read cmd
    $cmd "$f"
}}
map o open-with

# --- handy bindings ---
map <enter> open
map x cut
# y is a pure prefix (yy=copy, yK=kitty download); a bare `map y copy`
# would fire on first keypress and shadow yK, making it unreachable.
map y
map yy copy
map p paste
map d delete
map . set hidden!
map zh set hidden!
map gh cd ~
map gd cd ~/Downloads
map gN cd /n/netscratch/kozinsky_lab/Lab/demiranda
map gH cd /n/holylabs/kozinsky_lab/Users/demiranda
map gP cd /n/netscratch/kozinsky_lab/Lab/demiranda/projects

# --- reload config without quitting ---
cmd reload-config :{{
    source ~/.config/lf/lfrc
}}
map R reload-config

# --- delete with confirm ---
cmd trash %trash-put "$fx"
cmd delete ${{
    set -f
    printf "delete '%s'? [y/n] " "$fx" >&2
    read ans
    [ "$ans" = "y" ] && rm -rf -- $fx
}}

# --- mkdir / touch ---
cmd mkdir %{{ printf "dir name: " >&2; read d; mkdir -p -- "$d"; }}
cmd touch  %{{ printf "file name: " >&2; read f; touch -- "$f"; }}
map a push :mkdir<space>
map A push :touch<space>
